#!/usr/bin/env bash
#
# Blocks commits that would put a personal Apple Developer Team ID into the
# repository.
#
# Xcode rewrites DEVELOPMENT_TEAM back into project.pbxproj whenever you build
# with a team selected in Signing & Capabilities. It has silently ridden along
# in a `git add -A` and reached the public repo twice now, so this checks
# rather than relying on anyone noticing the line in a diff.
#
# Install:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
#
# Bypass, if you ever genuinely need to:
#   git commit --no-verify

if git diff --cached -U0 | grep -qE '^\+.*DEVELOPMENT_TEAM = [A-Z0-9]{10}'; then
    echo "pre-commit: refusing — this commit adds a DEVELOPMENT_TEAM to the project." >&2
    echo >&2
    git diff --cached -U0 --name-only -G'DEVELOPMENT_TEAM = [A-Z0-9]{10}' | sed 's/^/  /' >&2
    echo >&2
    echo "Xcode writes that line back whenever you build with a team selected." >&2
    echo "Drop it before committing:" >&2
    echo "  sed -i '' '/DEVELOPMENT_TEAM = [A-Z0-9]\\{10\\};/d' BoosteroidATV.xcodeproj/project.pbxproj" >&2
    echo >&2
    echo "Signing still works — Xcode keeps your team in local state, not in the" >&2
    echo "project file. See Local.xcconfig.example." >&2
    exit 1
fi
